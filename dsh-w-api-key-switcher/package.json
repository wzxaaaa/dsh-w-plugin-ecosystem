{
  "name": "dsh-w-api-key-switcher",
  "version": "0.1.4",
  "description": "Save multiple annotated API keys per model provider and switch the active credential with one click.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./api-key-switcher-core": "./api-key-switcher-core.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "api-key-switcher-core.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-typert-protocol": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
