{
  "name": "dsh-w-noval-write",
  "version": "0.14.2",
  "description": "Several novels per workspace, one folder each, with conversations bound to a novel; novel canon with schema-v5 genre extensions, structured volume/chapter outlines, a foreshadowing and payoff ledger, manuscripts linked to outline chapters with live word counts, a per-book knowledge-base style library, version history with compare and restore, live panel sync, targeted AI tools, verified manuscript export, and a persistent /write task.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./noval-write-core": "./noval-write-core.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "noval-write-core.js",
    "noval-mutation-guard.js",
    "noval-file-core.js",
    "noval-library.js",
    "noval-search-core.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/dsh-workspace": "*",
    "@deepseek-ai/schemastery": "*",
    "dsh-w-knowledge-base": ">=0.4.0",
    "dsh-w-right-sidebar": ">=0.6.0"
  },
  "peerDependenciesMeta": {
    "dsh-w-knowledge-base": {
      "optional": true
    },
    "dsh-w-right-sidebar": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  }
}
