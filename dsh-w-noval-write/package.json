{
  "name": "dsh-w-noval-write",
  "version": "0.8.2",
  "description": "Workspace-shared novel canon with schema-v4 genre extensions, structured volume/chapter outlines, targeted AI tools, verified manuscript export, and a persistent /write task.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./noval-write-core": "./noval-write-core.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "noval-write-core.js",
    "noval-mutation-guard.js",
    "noval-file-core.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/dsh-workspace": "*",
    "@deepseek-ai/schemastery": "*",
    "dsh-w-knowledge-base": ">=0.4.0",
    "dsh-w-right-sidebar": ">=0.6.0"
  },
  "peerDependenciesMeta": {
    "dsh-w-knowledge-base": { "optional": true },
    "dsh-w-right-sidebar": { "optional": true },
    "@deepseek-ai/dsh-commands": { "optional": true }
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
