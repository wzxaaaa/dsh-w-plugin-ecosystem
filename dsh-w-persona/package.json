{
  "name": "dsh-w-persona",
  "version": "0.3.0",
  "description": "DeepSeek Harness persona manager with reusable persona templates and an optional hidden four-message conversation preset.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./persona-patch-core": "./persona-patch-core.js",
    "./persona-template-core": "./persona-template-core.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "dialogue-preset-core.js",
    "persona-patch-core.js",
    "persona-template-core.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-typert-protocol": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
