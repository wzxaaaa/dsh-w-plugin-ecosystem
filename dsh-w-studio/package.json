{
  "name": "dsh-w-studio",
  "version": "0.2.0",
  "description": "A software-company Studio for configurable Codex, Claude Code, DeepSeek Harness and compatible-model employees, shared workspaces, task handoffs, review and delivery.",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "README.md", "BUILD.json", "compat/README.md", "compat/harness-sdk-session-resume.patch"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "test": "node --test test/*.test.mjs",
    "test:source": "node scripts/test-source.mjs"
  },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-subprocess": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-slots"],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzxaaaa/dsh-w-plugin-ecosystem.git",
    "directory": "dsh-w-studio"
  }
}
