diff --git a/packages/sdk/server/src/server.ts b/packages/sdk/server/src/server.ts
index 1cc17059c9..f67e8912bd 100644
--- a/packages/sdk/server/src/server.ts
+++ b/packages/sdk/server/src/server.ts
@@ -15,0 +16 @@ import type { SessionId } from '@deepseek-ai/dsh-session'
+import { SessionAlreadyExistsError } from '@deepseek-ai/dsh-session-persistence'
@@ -62,0 +64,2 @@ export interface HarnessSdkJsonRpcServerOptions {
+  /** Resume an exact persisted session id on its first prompt in this runtime; default is fresh-only. */
+  resumePersistedSessions?: boolean
@@ -279,10 +282,17 @@ export class HarnessSdkJsonRpcServer {
-    const handle = await this.ctx.agents.create({
-      sessionId: brandString<SessionId>(sessionId),
-      meta: { cwd: this.cwd },
-      agentOptions: {
-        provider: this.provider,
-        model: this.model,
-        ...this.reasoningEffort === undefined ? {} : { reasoningEffort: this.reasoningEffort },
-        ...this.maxTokens === undefined ? {} : { maxTokens: this.maxTokens },
-      },
-    })
+    const id = brandString<SessionId>(sessionId)
+    const agentOptions = {
+      provider: this.provider,
+      model: this.model,
+      ...this.reasoningEffort === undefined ? {} : { reasoningEffort: this.reasoningEffort },
+      ...this.maxTokens === undefined ? {} : { maxTokens: this.maxTokens },
+    }
+    let handle: AgentHandle
+    try { handle = await this.ctx.agents.create({ sessionId: id, meta: { cwd: this.cwd }, agentOptions }) }
+    catch (error) {
+      if (!(error instanceof SessionAlreadyExistsError) || this.options.resumePersistedSessions !== true) throw error
+      const persistence = this.ctx.get('sessionPersistence')
+      if (!persistence) throw new Error('SDK session resume requires persistence')
+      const stored = await persistence.stat(id)
+      if (stored?.header.cwd !== this.cwd) throw new Error('Persisted SDK session belongs to another working directory')
+      handle = await this.ctx.agents.resume({ resumeSessionId: id, agentOptions })
+    }
diff --git a/packages/sdk/server/tests/server.spec.ts b/packages/sdk/server/tests/server.spec.ts
index 43fd51257c..76a0a3f65c 100644
--- a/packages/sdk/server/tests/server.spec.ts
+++ b/packages/sdk/server/tests/server.spec.ts
@@ -114,0 +115,37 @@ describe('HarnessSdkJsonRpcServer', () => {
+  it('resumes persisted private history only when enabled and refuses another working directory', async () => {
+    const storageDir = await mkdtemp(join(tmpdir(), 'dsh-jsonrpc-resume-'))
+    const llmServer = await mockCompletionServer()
+    vi.stubEnv('DEEPSEEK_API_KEY', 'test-key')
+    vi.stubEnv('DEEPSEEK_BASE_URL', llmServer.url)
+    const ctx = await makeHarness(storageDir)
+    const servers: HarnessSdkJsonRpcServer[] = []
+    const open = async (enabled: boolean, cwd = storageDir) => {
+      const server = new HarnessSdkJsonRpcServer(ctx, new FakeTransport(), { resumePersistedSessions: enabled })
+      servers.push(server)
+      await server.initialize({ cwd, provider: 'deepseek-official', model: 'dsagent-model' })
+      return server
+    }
+    const prompt = (server: HarnessSdkJsonRpcServer, text: string) => server.prompt({ sessionId: 'persisted', contentBlocks: [{ type: 'text', text }] })
+    try {
+      const first = await open(false)
+      await prompt(first, 'Private employee context from the first runtime')
+      await ctx.agents.get(SessionId('persisted'))!.whenIdle()
+      await first.shutdown()
+      const fresh = await open(false)
+      await expect(prompt(fresh, 'Must refuse reuse')).rejects.toThrow('already exists')
+      await fresh.shutdown()
+      const wrong = await open(true, join(storageDir, 'different'))
+      await expect(prompt(wrong, 'Must refuse another directory')).rejects.toThrow('another working directory')
+      await wrong.shutdown()
+      const resumed = await open(true)
+      await prompt(resumed, 'Use your own previous private context')
+      await ctx.agents.get(SessionId('persisted'))!.whenIdle()
+      expect(llmServer.requests).toHaveLength(2)
+      expect(JSON.stringify(llmServer.requests[1])).toContain('Private employee context from the first runtime')
+      await resumed.shutdown()
+    } finally {
+      await Promise.allSettled(servers.map(server => server.shutdown()))
+      await ctx.fiber.dispose()
+      await rm(storageDir, { recursive: true, force: true })
+    }
+  })
