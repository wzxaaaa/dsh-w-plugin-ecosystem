{
  "name": "dsh-w-camera-watch",
  "version": "0.2.4",
  "description": "Live webcam snapshots plus automatic Goal speech transcription and message relay for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./camera-watch-core": "./camera-watch-core.js",
    "./windows-speech": "./windows-speech.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "camera-watch-core.js",
    "windows-speech.js",
    "browser-camera-bridge.js",
    "browser-camera.js",
    "browser-camera.html",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-typert-protocol": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  }
}
